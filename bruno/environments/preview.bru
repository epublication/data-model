vars {
  BASE_URL: https://preview.epublication.ch
  BASE_URL_API: {{BASE_URL}}/api
  BASE_URL_API_MGT: {{BASE_URL_API}}/management
  BASE_URL_API_INTERFACE: {{BASE_URL_API_MGT}}/interface/v1
  BASE_URL_PUBLIC_API_INTERFACE: {{BASE_URL_API_MGT}}/public/interface/v1
  TOKEN_URL: https://login.preview.epublication.ch/oauth2/token
  CLIENT_ID: <your-technical-user-client-id>
}
vars:secret [
  CLIENT_SECRET
]
