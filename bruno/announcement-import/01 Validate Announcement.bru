assert {
  res.status: eq 200
}

tests {
  test("returns 200 for a valid announcement", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Validates an announcement payload without submitting/publishing it.
  Runs against the **public zone** (`/public/interface/v1/announcements/validate`).

  Use this to check a payload's shape before calling the actual submission
  endpoint (02) — no announcement is created and nothing is published.

  Caveat: `auth: none` and the expected `200` response here are based on
  the endpoint's path prefix and general spec conventions, not an
  independently confirmed real response (unlike request 02, which mirrors
  a verified working submission). If this request fails unexpectedly,
  treat the auth requirement and status code as open questions rather than
  a bug in your payload.

  See ../../docs/announcement-import.md, Section 5, for the corresponding
  submission endpoint and its validation rules.
}
